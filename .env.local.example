# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local

# ─── Supabase ────────────────────────────────────────────────────────────────
# Found at: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-publishable-key>
# WARNING: Never expose this key in the browser. Server/Edge Functions only.
SUPABASE_SERVICE_ROLE_KEY=<your-server-only-secret-key>

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Found at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<your-webhook-signing-secret>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>
# Found at: https://dashboard.stripe.com/products (price ID of your Pro plan)
STRIPE_PRO_PRICE_ID=<your-pro-price-id>

# ─── Resend ──────────────────────────────────────────────────────────────────
# Found at: https://resend.com/api-keys
RESEND_API_KEY=<your-resend-api-key>

# ─── App ─────────────────────────────────────────────────────────────────────
# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: set this to your Vercel deployment URL
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
